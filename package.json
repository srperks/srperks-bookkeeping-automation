{
  "name": "srperks-bookkeeping-automation",
  "version": "1.0.0",
  "description": "Automated supplier bill and statement intake for SR Perks bookkeeping clients: Outlook to SharePoint to Xero draft bills.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "extract": "tsx src/scripts/extract-file.ts",
    "xero:auth": "tsx src/scripts/xero-auth.ts",
    "preflight": "tsx src/scripts/preflight.ts",
    "make-log-template": "tsx src/scripts/make-log-template.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
